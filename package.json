{
  "name": "angio-visu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D-Visualisierung einer Angio-Intervention mit realistischer Dosisverteilungs-Simulation während der Durchleuchtung",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build && node scripts/inline.mjs",
    "render:preview": "node scripts/render-preview.mjs",
    "update:preview": "node scripts/render-preview.mjs && cp docs/preview.png preview.png",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "vite": "^6.0.0"
  }
}
